[Unit]
Description=Quantum Brief Twitter Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/quantum-brief
ExecStart=/home/ubuntu/quantum-brief/venv/bin/python run_all.py
Restart=always
RestartSec=10
EnvironmentFile=/home/ubuntu/quantum-brief/.env

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=quantum-brief

[Install]
WantedBy=multi-user.target
